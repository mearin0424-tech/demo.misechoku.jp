# コピーして利用: cp .env.example .env
# 初回は php artisan key:generate を実行して APP_KEY を生成してください。

APP_NAME=ミセチョク
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

# ASSET_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# DATABASE_URL=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# メール（SendGrid SMTP 等。未使用なら MAIL_MAILER=log など）
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@misechoku.jp
MAIL_FROM_NAME="${APP_NAME}"

# SendGrid API（アプリ外ツールや将来の拡張用。未使用なら空で可）
SENDGRID_API_KEY=

# LINE ログイン・Messaging API（config/services.php）
#
# 【LINE Login】LINE Developers → 該当チャネル → LINE Login タブ → コールバック URL に例:
#   https://あなたのドメイン/login/line/callback
# （Messaging API の Webhook URL とは別です。ここを Webhook にすると redirect_uri エラーになります）
#
# LINE_REDIRECT_URI を空にすると、実際のリクエストの https とドメインからコールバックURLを組み立てる。
# 明示する場合は上記と完全一致（末尾スラッシュ含む）にすること。
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI="${APP_URL}/login/line/callback"
#
# 【Messaging API】同じチャネル（またはリンクしたチャネル）の Channel secret / token。
# Webhook URL には例: https://あなたのドメイン/line/webhook （POST のみ、本アプリが 200 を返す）
# 検証で 401 になる場合はリバプロのベーシック認証・WAF・別 URL 誤指定を疑う（Laravel では通常 400/503）。
LINE_MESSAGE_CHANNEL_ID=
LINE_MESSAGE_CHANNEL_SECRET=
LINE_MESSAGE_CHANNEL_TOKEN=

# LINE Notify 連携（レガシー用。未使用なら空で可）
LINE_NOTIFY_CLIENT_ID=
LINE_NOTIFY_CLIENT_SECRET=
LINE_NOTIFY_CALLBACK_URL="${APP_URL}/line-notify/callback"

GOOGLE_MAP_API=
# GOOGLE_MAP_API_IP=

# Web Push（php artisan push:vapid で生成）
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
